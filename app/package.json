{
    "name": "app",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "start": "export NODE_ENV=dev; nodemon src/index.ts",
        "dev": "ts-node src/index.ts",
        "build": "tsc",
        "test": "NODE_ENV=test jest --runInBand",
        "github-test": "NODE_ENV=test jest --runInBand",
        "init-db": "npx prisma migrate dev --name init",
        "seed-db": "npx prisma db seed",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit"
    },
    "prisma": {
        "seed": "node dist/prisma/seed.js"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "@prisma/client": "^6.15.0",
        "cors": "^2.8.5",
        "dotenv": "^17.2.1",
        "express": "^5.1.0",
        "mysql2": "^3.12.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.3.0",
        "@types/supertest": "^6.0.2",
        "dotenv-cli": "^8.0.0",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^29.7.0",
        "nodemon": "^3.1.9",
        "prettier": "^3.9.6",
        "prisma": "^6.12.0",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.6",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.65.0"
    }
}
