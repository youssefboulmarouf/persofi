# Backend environment variables. Copy to `.env` and fill in real values —
# never commit `.env` (it is already gitignored).
#
# Full contract, scope, defaults, and rotation guidance:
# docs/operations/STAB_005_ENV_CONTRACT.md

# Required in production. Rejected at startup if missing or blank when
# NODE_ENV=production (see src/utilities/validateEnv.ts).
# Must include a real, non-empty password — never an empty-password connection
# string in any deployed environment.
DATABASE_URL=mysql://user:CHANGE_ME@localhost:3306/persofi

# One of: dev | test | production. Controls whether the HTTP server starts,
# whether production environment variables are enforced, and Prisma logging.
NODE_ENV=dev

# Optional. Defaults to 5000 if unset.
PORT=5000
