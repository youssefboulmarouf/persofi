# Frontend environment variables. Copy to `.env` and fill in real values —
# never commit `.env` (it is already gitignored).
#
# Full contract, scope, defaults, and rotation guidance:
# docs/operations/STAB_005_ENV_CONTRACT.md
#
# Read at BUILD time only (baked into the static bundle by Create React App /
# the production Docker build's REACT_APP_API_BASE_URL build ARG). It is not
# read again at container runtime, and it holds no secret — it is only the
# public base URL the browser calls.

REACT_APP_API_BASE_URL=http://localhost:5000
