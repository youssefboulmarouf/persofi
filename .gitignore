.idea/
.env

app/.env
app/.env.test
app/node_modules/
app/logs/
app/src/logs/
app/dist/
app/coverage/

# Generated JS / source-map files (compiled from TypeScript)
app/**/*.js
app/**/*.js.map
app/**/*.d.ts
# But keep config files that are intentionally JS
!app/jest.config.js

client/.env
client/node_modules/
client/build/

# Sensitive operational artifacts (STAB-001 and later recovery runs)
backups/
*.sql
*.sql.gz
*.gpg
*.sha256
*.backup-key

# Prisma migration history is source code and must remain tracked.
# This exception intentionally overrides the generic SQL-artifact rule above.
!app/prisma/migrations/
!app/prisma/migrations/**
